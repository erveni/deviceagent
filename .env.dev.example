# Copy this to .env.dev and fill in real values. .env.dev is gitignored.
# These power the Mac-side consumer (solace_consumer.py) against the
# deployed dev RabbitMQ broker. For prod, copy to .env.prod and swap values.

# --- RabbitMQ broker ---
# Pull dev creds from AWS Secrets Manager:
#   aws --profile aeo-admin secretsmanager get-secret-value \
#     --secret-id android-device-farm/dev/rabbitmq/broker/settings/admin \
#     --query SecretString --output text
RABBITMQ_HOST=18.210.14.130
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=REPLACE_ME
RABBITMQ_VHOST=/

# --- AEOAdmin (for build-session-static prompts) ---
# Used by solace_consumer.py when DISPATCH_ENABLED=1. Pull from
# aws --profile aeo-admin secretsmanager get-secret-value --secret-id aeo-admin/prod
ADMIN_BASE=https://jjm59vpn3y.us-east-1.awsapprunner.com
EXECUTOR_TOKEN=REPLACE_ME

# --- Decodo proxy (used by run_with_proxy.py and gost subprocess in consumer) ---
PROXY_HOST=gate.decodo.com
PROXY_PORT=10001
PROXY_USER=REPLACE_ME
PROXY_PASS=REPLACE_ME

# --- Local paths ---
GOST_BIN=/opt/homebrew/bin/gost
